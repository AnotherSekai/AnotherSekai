{
  "name": "sekai",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:*",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite",
    "start:api": "bun server/index.ts",
    "start": "bun dist/server.js",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "bun build ./server/index.ts --target=bun --outfile ./dist/server.js",
    "preview": "vite preview"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@sekai-world/pixi-live2d-display-mulmotion": "0.5.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.575.0",
    "pixi.js": "7.4.3",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
